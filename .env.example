# Server Config
SERVER_USERNAME=agili
SERVER_PASSWORD=cloud-code

# Optional: OpenCode v2 container API password (image_vars OPENCODE_MAJOR="2").
# Falls back to SERVER_PASSWORD when unset.
OPENCODE_PASSWORD=

# S3 Persistence Config
# Placeholders only. The container mounts S3 only when all four values are set,
# so leaving them as-is keeps local mode. Never commit real credentials here.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
S3_BUCKET=<bucket-name>
S3_PREFIX=cloud-code
